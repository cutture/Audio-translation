# Copy to .env and fill in your key.
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_DETECTION_MODEL=gpt-4.1-mini
# OPENAI_TRANSLATION_MODEL=gpt-4.1
# OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
# OPENAI_SPEECH_VOICE=marin
# DATA_DIR=./data
# HOST=127.0.0.1
# PORT=5001
# FLASK_DEBUG=1

# Accounts. Set ALLOW_SIGNUPS=0 so only the admin can create accounts (CLI).
# ALLOW_SIGNUPS=1

# "Continue with Google / GitHub". Each button appears once both values are set.
# Redirect URI to register: <your app URL>/api/auth/oauth/google/callback (or .../github/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Sign-in sessions. Without SECRET_KEY a random key is generated and kept in DATA_DIR.
# SECRET_KEY=
# SESSION_DAYS=7
# SESSION_COOKIE_SECURE=1        # set when the app is served over HTTPS
# TRUSTED_PROXIES=1              # number of reverse proxies in front of the app (hosting platforms)

# Rate limits ("N per second|minute|hour|day", several separated by ";").
# RATE_LIMIT_LOGIN=5 per minute; 50 per day          # per IP address
# RATE_LIMIT_SIGNUP=5 per hour; 20 per day           # per IP address, accounts actually created
# RATE_LIMIT_OAUTH=20 per minute                     # per IP address
# RATE_LIMIT_TRANSCRIBE=10 per minute; 200 per day   # per user
# RATE_LIMIT_TRANSLATE=30 per minute; 500 per day    # per user
# RATE_LIMIT_SPEECH=30 per minute; 500 per day       # per user
# RATE_LIMIT_SHARE=10 per minute; 100 per day        # per user
# RATE_LIMIT_SHARE_AUDIO=30 per minute               # per IP address (public share pages)
# RATE_LIMIT_STORAGE_URI=memory://                   # e.g. redis://localhost:6379 with several workers
